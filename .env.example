# Copy to .env.local (git-ignored). NEVER put a Gemini API key in a VITE_* variable: Vite embeds
# those in the public JS bundle (and therefore the APK/AAB).

# Optional: URL of your deployed chronicle proxy (see server/chronicle-proxy.mjs).
# Leave empty to play with the built-in local chronicle (fully offline).
VITE_CHRONICLE_ENDPOINT=

# --- server side only (set in the proxy's environment, not in the game) ---
# GEMINI_API_KEY=<set on the server>
# ALLOWED_ORIGINS=https://localhost,https://your-site.example
